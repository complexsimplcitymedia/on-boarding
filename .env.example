# Wolf Logic Onboarding — Environment Variables
# Copy to .env (local) or set as host/CI secrets (production)

# API
VITE_API_BASE=https://api.wolflogic-ai.com

# Auth0
VITE_AUTH0_DOMAIN=wolflogic-ai.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.wolflogic-ai.com

# PostgREST JWT (wolf_admin role, 10-year token)
# Generate with: python3 scripts/gen_jwt.py
VITE_WOLF_JWT=

# Authentik (legacy, can be left blank if not used)
VITE_AUTHENTIK_URL=
VITE_AUTHENTIK_CLIENT_ID=
